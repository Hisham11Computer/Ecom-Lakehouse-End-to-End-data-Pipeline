FROM apache/airflow:2.8.1-python3.9

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    default-jre-headless \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/default-java

USER airflow


RUN pip install --no-cache-dir pyspark==3.5.1 delta-spark==3.1.0 polars pyarrow


RUN PIP_USER=false python -m venv /home/airflow/gx-venv \
    && PIP_USER=false /home/airflow/gx-venv/bin/pip install --no-cache-dir --upgrade pip \
    && PIP_USER=false /home/airflow/gx-venv/bin/pip install --no-cache-dir \
       "great-expectations>=1.3,<1.5" deltalake pandas pyarrow